# Server only. Copy to .env locally; configure these in Vercel for production.
# Never put these values in app/assets/js/env.js or any VITE_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_JARVIS_MODEL=
APP_ORIGIN=https://www.zam4.com
JARVIS_ENABLED=false
JARVIS_MEMORY_ENABLED=false
# Reserved: voice is not implemented in this first text delivery.
JARVIS_VOICE_ENABLED=false
JARVIS_MAX_TOOL_CALLS=6
JARVIS_REQUESTS_PER_MINUTE=10
JARVIS_REQUESTS_PER_DAY=200
# Optional current model prices; absent prices mean unknown cost, not free usage.
OPENAI_JARVIS_INPUT_USD_PER_MILLION=
OPENAI_JARVIS_OUTPUT_USD_PER_MILLION=
