{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "app",
  "cleanUrls": true,
  "headers": [{ "source": "/dot-confirm(.*)", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }, { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }, { "key": "Cache-Control", "value": "no-store" }] }, { "source": "/dot-authorize(.*)", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }, { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; connect-src 'self' https://rtiwoctipvlsejxcptks.supabase.co; style-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'" }, { "key": "Cache-Control", "value": "no-store" }, { "key": "Referrer-Policy", "value": "no-referrer" }] }],
  "functions": { "api/jarvis.js": { "maxDuration": 180 }, "api/reminder-cron.js": { "maxDuration": 60 }, "api/project-access.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/jarvis/:path*", "destination": "/api/jarvis?path=:path*" }, { "source": "/api/reminders/:path*", "destination": "/api/reminders?path=:path*" }, { "source": "/.well-known/oauth-protected-resource", "destination": "/api/dot-oauth?path=resource" }, { "source": "/.well-known/oauth-protected-resource/api/dot-mcp", "destination": "/api/dot-oauth?path=resource" }, { "source": "/.well-known/oauth-authorization-server", "destination": "/api/dot-oauth?path=metadata" }, { "source": "/api/dot-oauth/authorize", "destination": "/api/dot-oauth?path=authorize" }, { "source": "/api/dot-oauth/consent", "destination": "/api/dot-oauth?path=consent" }, { "source": "/api/dot-oauth/token", "destination": "/api/dot-oauth?path=token" }]
}
