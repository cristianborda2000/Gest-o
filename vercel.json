{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "app",
  "cleanUrls": true,
  "headers": [{ "source": "/dot-confirm(.*)", "headers": [{ "key": "X-Frame-Options", "value": "DENY" }, { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }, { "key": "Cache-Control", "value": "no-store" }] }],
  "functions": { "api/jarvis.js": { "maxDuration": 180 }, "api/reminder-cron.js": { "maxDuration": 60 }, "api/project-access.js": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/jarvis/:path*", "destination": "/api/jarvis?path=:path*" }, { "source": "/api/reminders/:path*", "destination": "/api/reminders?path=:path*" }]
}
