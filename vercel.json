{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build:css",
  "outputDirectory": "app",
  "cleanUrls": true,
  "functions": { "api/jarvis.js": { "maxDuration": 180 } },
  "rewrites": [{ "source": "/api/jarvis/:path*", "destination": "/api/jarvis?path=:path*" }]
}
