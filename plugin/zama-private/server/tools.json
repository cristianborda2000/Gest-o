[
  {
    "name": "list_tasks",
    "description": "Consulte tarefas antes de escolher um ID para editar, concluir ou cancelar. Filtre hoje, próximas ou atrasadas. Nunca invente IDs. Conta pessoal do proprietário. Só escreva mediante pedido explícito. Datas usam America/Sao_Paulo.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": [
            "all",
            "pending",
            "completed",
            "overdue"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "description": "UUID único por pedido. Reutilize exatamente o mesmo UUID e argumentos após timeout; nunca gere outro para repetir o mesmo pedido."
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
