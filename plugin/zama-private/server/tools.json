  {
    "name": "create_task",
    "description": "Crie uma tarefa na agenda. Exige título claro e data; se faltar, pergunte. Data aceita amanhã/sexta/hoje e espanhol. Horário omitido significa sem hora definida. Salve a antecedência solicitada em reminder_minutes. Conta pessoal do proprietário. Só escreva mediante pedido explícito. Datas usam America/Sao_Paulo.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        },
        "date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "time": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "duration_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "reminder_minutes": {
          "description": "Antecedência do aviso em minutos: 15 para 15 minutos antes, 0 na hora, -1 sem lembrete, null usa a configuração geral. Exige horário para um aviso individual. Não ativa notificações nem permite entrega com aplicativo fechado.",
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1,
              "maximum": 1440
            },
            {
              "type": "null"
            }
          ]
        },
        "recurrence": {
          "type": "string",
          "enum": [
            "none",
            "daily",
            "weekdays",
            "weekly",
            "monthly"
          ]
        },
        "recurrence_end": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "description": "UUID único por pedido. Reutilize exatamente o mesmo UUID e argumentos após timeout; nunca gere outro para repetir o mesmo pedido."
        }
      },
      "required": [
        "title",
        "date",
        "request_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
